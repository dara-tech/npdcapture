{
  "name": "capture-tracker-custom",
  "version": "1.0.2",
  "author": "Sovandara Cheol - DMU",
  "description": "Custom DHIS2 Capture Tracker app",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/ensure-app-icons.mjs",
    "prebuild": "node scripts/ensure-app-icons.mjs && node scripts/ensure-locales.mjs",
    "build": "REACT_APP_DHIS2_API_VERSION=40 d2-app-scripts build && node scripts/ensure-app-icons.mjs --patch-build",
    "prestart": "node scripts/ensure-app-icons.mjs && node scripts/ensure-locales.mjs",
    "start": "REACT_APP_DHIS2_API_VERSION=40 d2-app-scripts start",
    "test": "REACT_APP_DHIS2_API_VERSION=40 d2-app-scripts test",
    "deploy": "REACT_APP_DHIS2_API_VERSION=40 d2-app-scripts deploy",
    "shadcn": "shadcn"
  },
  "dependencies": {
    "@dhis2/app-runtime": "^3.14.5",
    "@dhis2/d2-i18n": "^1.0.0",
    "@dhis2/rule-engine": "^3.8.1",
    "@dhis2/ui": "^10.8.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.14.0",
    "react": "^18",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@dhis2/cli-app-scripts": "^12.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "shadcn": "^4.6.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
